[global]
monitor = 0
follow = none

width = 360
height = (0, 300)

origin = top-right
offset = (15, 50)

scale = 0

notification_limit = 5

padding = 10
horizontal_padding = 12
text_icon_padding = 8

frame_width = 2
frame_color = #787878

corner_radius = 8
corners = all

font = JetBrainsMono Nerd Font 11
markup = full

format = "<b>%s</b>\n%b"

sort = yes
indicate_hidden = yes

history_length = 20

mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[experimental]

[urgency_low]
timeout = 3

[urgency_normal]
timeout = 5

[urgency_critical]
timeout = 0
frame_color = #787878
